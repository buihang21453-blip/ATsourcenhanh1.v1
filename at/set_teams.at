local m = { version = "1.3.0" }

local config_path
local enabled = false
local forced_home, forced_away = 0, 0
local current_home, current_away = 0, 0
local status = "waiting for team menu"
local control_slot
local hook_addr
local installed = false
local confirmed = false

local function trim(s)
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function find_config(ctx)
    local candidates = {
        ".\\at\\set_teams.ini",
        ctx.at_dir and (ctx.at_dir .. "at\\set_teams.ini") or nil,
        ctx.at_dir and (ctx.at_dir .. "\\at\\set_teams.ini") or nil,
    }
    for _, path in ipairs(candidates) do
        if path then
            local file = io.open(path, "r")
            if file then
                file:close()
                return path
            end
        end
    end
    return ".\\at\\set_teams.ini"
end

local function write_control_slot()
    if not control_slot then return end
    local active = enabled and 1 or 0
    local data = string.char(active) .. string.rep("\0", 7)
        .. memory.pack("u32", forced_home)
        .. memory.pack("u32", forced_away)
    memory.write(control_slot, data)
end

local function read_request()
    local file = io.open(config_path, "r")
    if not file then
        enabled = false
        status = "set_teams.ini not found"
        write_control_slot()
        return false
    end

    local values = {}
    for line in file:lines() do
        line = line:gsub("[;#].*$", "")
        local key, value = line:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
        if key and value then values[key:lower()] = trim(value) end
    end
    file:close()

    enabled = tonumber(values.enabled or "0") == 1
    forced_home = tonumber(values.home or "0") or 0
    forced_away = tonumber(values.away or "0") or 0
    confirmed = false

    if not enabled then
        status = "disabled"
        write_control_slot()
        return false
    end
    if forced_home < 1 or forced_home > 0x1ffff
        or forced_away < 1 or forced_away > 0x1ffff then
        enabled = false
        status = "invalid team id"
        write_control_slot()
        return false
    end

    write_control_slot()
    status = string.format("armed: %d vs %d", forced_home, forced_away)
    return true
end

local function abs_jump(address)
    return "\xff\x25\x00\x00\x00\x00" .. memory.pack("u64", address)
end

local function install_commit_hook()
    local pattern = "\x48\x8b\x47\x20\x48\x89\x43\x20"
        .. "\x48\x8b\x5c\x24\x40\x48\x83\xc4\x30"
    hook_addr = memory.search_process(pattern)
    if not hook_addr then
        status = "AOB team-pair commit not found"
        log("SET TEAMS v1.3.0 ERROR: " .. status)
        return false
    end

    control_slot = memory.allocate_codecave(16)
    memory.write(control_slot, string.rep("\0", 16))
    read_request()

    local cave = memory.allocate_codecave(160)
    local original_tail = pattern:sub(9)
    local code =
        "\x41\x52" ..
        "\x41\x53" ..
        "\x49\xbb" .. memory.pack("u64", control_slot) ..
        "\x41\x80\x3b\x00" ..
        "\x74\x0a" ..
        "\x49\x8b\x43\x08" ..
        "\x48\x89\x47\x20" ..
        "\xeb\x04" ..
        "\x48\x8b\x47\x20" ..
        "\x48\x89\x43\x20" ..
        "\x41\x5b" ..
        "\x41\x5a" ..
        original_tail ..
        abs_jump(hook_addr + #pattern)

    memory.write(cave, code)
    memory.write(hook_addr, abs_jump(cave) .. "\x90\x90\x90")
    installed = true
    status = string.format("hook ready: %d vs %d", forced_home, forced_away)
    log(string.format(
        "SET TEAMS v1.3.0 hook=%s control=%s cave=%s target=%d vs %d",
        memory.hex(hook_addr), memory.hex(control_slot), memory.hex(cave),
        forced_home, forced_away))
    return true
end

function m.set_teams(ctx, home, away)
    current_home, current_away = home, away
    confirmed = enabled and home == forced_home and away == forced_away
    if confirmed then
        status = string.format("APPLIED: PES confirmed %d vs %d", home, away)
    else
        status = string.format("PES confirmed %d vs %d", home, away)
    end
    log("SET TEAMS v1.3.0: " .. status)
end

local function reload_request()
    local old_home, old_away, old_enabled = forced_home, forced_away, enabled
    read_request()
    if old_home ~= forced_home or old_away ~= forced_away or old_enabled ~= enabled then
        log(string.format("SET TEAMS v1.3.0 request reloaded: enabled=%s, %d vs %d",
            tostring(enabled), forced_home, forced_away))
    end
end

function m.key_down(ctx, vkey)
    reload_request()
end

function m.gamepad_input(ctx, inputs)
    reload_request()
end

function m.overlay_on(ctx)
    reload_request()
    return string.format(
        "PES ARENA SET TEAMS v1.3.0\nPES confirmed: %d vs %d\nTarget: %d vs %d\nHook: %s\nStatus: %s",
        current_home, current_away, forced_home, forced_away,
        installed and "READY" or "FAILED", status)
end

function m.init(ctx)
    config_path = find_config(ctx)
    log("SET TEAMS v1.3.0 CONFIG: " .. config_path)
    install_commit_hook()
    ctx.register("set_teams", m.set_teams)
    ctx.register("key_down", m.key_down)
    ctx.register("gamepad_input", m.gamepad_input)
    ctx.register("overlay_on", m.overlay_on)
    log("PES Arena Set Teams v1.3.0 loaded")
end

return m
