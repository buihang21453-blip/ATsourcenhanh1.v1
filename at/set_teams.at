local m = { version = "1.5.1" }

local current_home, current_away = 0, 0
local status = "dang cho core set_team_id"

function m.set_teams(ctx, home, away)
    current_home, current_away = home, away
    status = string.format("Core xac nhan Home=%d Away=%d", home, away)
    log("SET TEAM COREHOOK NHANH 1 v1.5.1: " .. status)
    -- v1.5.1: Lua chi quan sat/log. Viec ep doi nam trong at.cpp core hook.
end

function m.overlay_on(ctx)
    return string.format(
        "PES ARENA - NHANH 1 - SET TEAM COREHOOK v1.5.1\n" ..
        "PES/Core doc duoc: %d vs %d\nTrang thai: %s",
        current_home, current_away, status)
end

function m.init(ctx)
    ctx.register("set_teams", m.set_teams)
    ctx.register("overlay_on", m.overlay_on)
    log("PES Arena - Nhanh 1 - Set Team CoreHook v1.5.1 loaded")
    log("SET TEAM COREHOOK NHANH 1 v1.5.1: Lua observer; force logic is in at.cpp")
end

return m
